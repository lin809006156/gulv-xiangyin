/**
 * 古律象音 · 小程序全局样式
 * 宣纸墨色，呼应卦象的东方气质
 */

page {
  --paper: #F5F0E6;
  --paper-deep: #E5DCCC;
  --card: #FBF8F1;
  --ink: #2B2620;
  --ink-2: #4A443C;
  --ink-3: #6E675C;
  --ink-4: #8A8175;
  --cinnabar: #B23A2E;
  --cinnabar-soft: rgba(178, 58, 46, .12);
  --line: #C9BFAD;
  --line-soft: #E0D7C6;
  --gold: #A8894F;

  background: var(--paper);
  color: var(--ink);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, scroll-view {
  box-sizing: border-box;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border: 2rpx solid var(--line-soft);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(43, 38, 32, .04);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-head .title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: .08em;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  letter-spacing: .1em;
  transition: opacity .2s;
}

.btn::after { border: none; }

.btn-primary {
  background: var(--cinnabar);
  color: #FFF8F0;
  box-shadow: 0 4rpx 14rpx rgba(178, 58, 46, .22);
}

.btn-ghost {
  background: transparent;
  border: 2rpx solid var(--line);
  color: var(--ink-2);
}

.btn-sm {
  height: 60rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.btn-disabled {
  background: var(--paper-deep);
  color: var(--ink-4);
  box-shadow: none;
}

/* ---------- 文本 ---------- */
.panel-desc {
  font-size: 26rpx;
  color: var(--ink-3);
  line-height: 1.85;
  margin: 0 0 28rpx;
}

.panel-note {
  font-size: 23rpx;
  color: var(--ink-4);
  margin-top: 20rpx;
  line-height: 1.7;
}

.disclaimer {
  padding: 32rpx 40rpx 60rpx;
  font-size: 22rpx;
  color: var(--ink-4);
  line-height: 1.9;
  text-align: center;
}

.disclaimer .strong {
  color: var(--ink-3);
  font-weight: 600;
}
