/* 底部玻璃胶囊标签栏（与网页版同款：悬浮、半透明、圆角胶囊） */
.tabbar-wrap {
  position: fixed;
  left: 0; right: 0;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  pointer-events: none;
  z-index: 90;
}
.tabbar {
  pointer-events: auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  width: 600rpx;
  padding: 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(160deg, rgba(255,254,250,.92), rgba(252,249,242,.70));
  border: 1rpx solid rgba(178,160,132,.22);
  box-shadow: 0 2rpx 0 rgba(255,255,255,.8) inset,
              0 20rpx 60rpx rgba(58,48,34,.16);
}
.tabitem {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 0 12rpx;
  border-radius: 999rpx;
  color: var(--ink-3);
  transition: background .22s ease, color .22s ease, transform .2s cubic-bezier(.2,.9,.25,1.1);
}
.tabitem.is-on {
  color: var(--cinnabar);
  background: linear-gradient(170deg, rgba(255,255,255,.95), rgba(255,255,255,.60));
  box-shadow: 0 2rpx 0 rgba(255,255,255,.9) inset, 0 8rpx 22rpx rgba(58,48,34,.12);
}
.tabitem:active { transform: scale(.95); }

.tb-txt {
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: .1em;
}

/* ===============================================================
   图标：全部用 CSS 形状拼出（不依赖图片资源，包体零增长）
   颜色统一 currentColor，随选中态变朱砂
   =============================================================== */

.tb-ico {
  width: 44rpx; height: 44rpx;
  display: flex; align-items: center; justify-content: center;
}
.tb-ico .tb-shape {
  position: relative;
  width: 36rpx; height: 32rpx;
}

/* ---------- 一、起卦：三爻（阳爻实、阴爻断） ---------- */
.tb-shape .tb-line {
  position: absolute;
  left: 0;
  width: 36rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: currentColor;
}
.tb-shape .tb-line.is-broken {
  width: 15rpx;
}
.tb-shape .tb-line.is-broken + .tb-line.is-broken {
  left: 21rpx;
}

/* ---------- 二、音乐：符头 + 符干 + 符尾 ---------- */
.tb-shape.tb-music .tb-note {
  position: absolute;
  left: 3rpx; bottom: 3rpx;
  width: 13rpx; height: 10rpx;
  border-radius: 50% 50% 42% 42%;
  background: currentColor;
  transform: rotate(-16deg);
}
.tb-shape.tb-music .tb-stem {
  position: absolute;
  left: 14rpx; bottom: 9rpx;
  width: 3rpx; height: 22rpx;
  border-radius: 2rpx;
  background: currentColor;
}
.tb-shape.tb-music .tb-flag {
  position: absolute;
  left: 17rpx; top: 1rpx;
  width: 0; height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 5rpx solid transparent;
  border-left: 13rpx solid currentColor;
}

/* ---------- 三、学易：书册（两页 + 书脊） ---------- */
.tb-shape.tb-book .tb-page {
  position: absolute;
  top: 3rpx;
  width: 17rpx; height: 26rpx;
  background: currentColor;
}
.tb-shape.tb-book .tb-page.left {
  left: 0;
  border-radius: 3rpx 0 0 3rpx;
  opacity: .92;
}
.tb-shape.tb-book .tb-page.right {
  right: 0;
  border-radius: 0 3rpx 3rpx 0;
  opacity: .58;
}
.tb-shape.tb-book .tb-spine {
  position: absolute;
  left: 17rpx; top: 3rpx;
  width: 2rpx; height: 26rpx;
  background: currentColor;
  opacity: .42;
}
