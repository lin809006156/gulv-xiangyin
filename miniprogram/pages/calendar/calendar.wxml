<!-- 学易心音 · 卦历 -->
<view class="page">

  <view class="head">
    <text class="head-title">卦历</text>
    <text class="head-sub">已记录的卦象，点击可回看并重听</text>
  </view>

  <view wx:if="{{empty}}" class="empty">
    <text class="empty-mark">卦</text>
    <text class="empty-text">还没有记录</text>
    <text class="empty-sub">回到首页取今日之卦</text>
  </view>

  <view wx:else class="list">
    <view
      class="item"
      wx:for="{{list}}"
      wx:key="key"
      data-n="{{item.n}}"
      bindtap="replay"
    >
      <text class="item-symbol">{{item.symbol}}</text>
      <view class="item-body">
        <view class="item-title-row">
          <text class="item-name">{{item.name}}</text>
          <text wx:if="{{item.image}}" class="item-image">观{{item.image}}</text>
        </view>
        <text class="item-hint">{{item.hint}}</text>
        <text class="item-method">{{item.method}}</text>
      </view>
      <view class="item-date">
        <text>{{item.date}}</text>
        <text class="item-time">{{item.time}}</text>
      </view>
    </view>

    <view class="btn btn-ghost clear-btn" bindtap="clearAll">清空卦历</view>
  </view>

</view>
