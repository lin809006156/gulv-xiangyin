/* 古律象音 · 卦历页样式 */

.page { padding-bottom: 40rpx; }

.head {
  padding: 40rpx 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.head-title {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: .16em;
  color: var(--ink);
}

.head-sub {
  font-size: 23rpx;
  color: var(--ink-4);
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 140rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.empty-mark {
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: var(--paper-deep);
  color: var(--ink-4);
  font-size: 46rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.empty-text { font-size: 29rpx; color: var(--ink-3); }
.empty-sub { font-size: 23rpx; color: var(--ink-4); }

/* ---------- 列表 ---------- */
.list {
  padding: 12rpx 24rpx 0;
}

.item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--card);
  border: 2rpx solid var(--line-soft);
  border-radius: 14rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 16rpx;
}

.item-symbol {
  font-size: 44rpx;
  color: var(--cinnabar);
  line-height: 1;
  flex-shrink: 0;
  width: 56rpx;
  text-align: center;
}

.item-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.item-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.item-name {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 600;
}

.item-image {
  font-size: 19rpx;
  color: var(--cinnabar);
  background: var(--cinnabar-soft);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.item-hint {
  font-size: 23rpx;
  color: var(--ink-3);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-method {
  font-size: 19rpx;
  color: var(--ink-4);
}

.item-date {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
  font-size: 20rpx;
  color: var(--ink-4);
  flex-shrink: 0;
}

.item-time {
  font-size: 18rpx;
  color: var(--ink-4);
  opacity: .8;
}

.clear-btn {
  margin-top: 24rpx;
}
