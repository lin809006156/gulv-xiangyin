/* 学易心音 · 首页样式 */

.page {
  padding-bottom: 40rpx;
}

/* ---------- 顶部 ---------- */
.header {
  padding: 36rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background: linear-gradient(180deg, #EFE8DA 0%, rgba(245, 240, 230, 0) 100%);
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-mark {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: var(--cinnabar);
  color: #FFF8F0;
  font-size: 42rpx;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 14rpx rgba(178, 58, 46, .26);
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.brand-title {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: .16em;
  color: var(--ink);
}

.brand-sub {
  font-size: 22rpx;
  color: var(--ink-4);
  letter-spacing: .04em;
}

.header-date {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  font-size: 25rpx;
  color: var(--ink-3);
}

.date-num {
  font-size: 21rpx;
  color: var(--ink-4);
  letter-spacing: .1em;
}

/* ---------- 标签页 ---------- */
.tabs {
  display: flex;
  gap: 8rpx;
  background: var(--paper-deep);
  border-radius: 10rpx;
  padding: 6rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: var(--ink-3);
  border-radius: 8rpx;
  transition: background .2s, color .2s;
}

.tab.is-active {
  background: var(--card);
  color: var(--cinnabar);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(43, 38, 32, .06);
}

.panel { display: block; }

/* ---------- 物象选择 ---------- */
.image-groups { margin-bottom: 24rpx; }

.img-group { margin-bottom: 24rpx; }

.img-group-title {
  display: block;
  font-size: 23rpx;
  color: var(--ink-4);
  letter-spacing: .12em;
  margin-bottom: 14rpx;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.img-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 20rpx;
  background: var(--paper);
  border: 2rpx solid var(--line-soft);
  border-radius: 30rpx;
  transition: all .2s;
}

.img-chip.is-selected {
  background: var(--cinnabar-soft);
  border-color: var(--cinnabar);
}

.chip-name {
  font-size: 25rpx;
  color: var(--ink-2);
}

.chip-gua {
  font-size: 21rpx;
  color: var(--ink-4);
}

.img-chip.is-selected .chip-name { color: var(--cinnabar); font-weight: 600; }
.img-chip.is-selected .chip-gua { color: var(--cinnabar); }

.image-selected {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--paper);
  border-radius: 10rpx;
  margin-bottom: 24rpx;
}

.sel-label {
  font-size: 22rpx;
  color: var(--ink-4);
}

.sel-name {
  font-size: 28rpx;
  color: var(--cinnabar);
  font-weight: 600;
}

.sel-gua {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ---------- 数字输入 ---------- */
.number-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.num-field {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.num-label {
  font-size: 23rpx;
  color: var(--ink-3);
}

.num-input {
  height: 84rpx;
  background: var(--paper);
  border: 2rpx solid var(--line-soft);
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: var(--ink);
  text-align: center;
}

/* ---------- 卦象展示 ---------- */
.result-head {
  display: flex;
  gap: 28rpx;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.yao-figure {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  width: 96rpx;
  flex-shrink: 0;
  padding-top: 6rpx;
}

.yao {
  display: flex;
  gap: 12rpx;
  height: 16rpx;
  align-items: center;
}

.yao-line {
  height: 14rpx;
  border-radius: 2rpx;
}

.yao-line.solid {
  width: 96rpx;
  background: var(--ink);
}

.yao-line.broken {
  width: 96rpx;
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
}

.yao-half {
  width: 42rpx;
  height: 14rpx;
  background: var(--ink);
  border-radius: 2rpx;
}

.yao.moving .yao-line.solid,
.yao.moving .yao-half {
  background: var(--cinnabar);
}

.yao.changed .yao-line.solid,
.yao.changed .yao-half {
  background: var(--gold);
}

.result-title {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.result-symbol {
  font-size: 62rpx;
  color: var(--cinnabar);
  line-height: 1.1;
}

.result-name {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: .1em;
  color: var(--ink);
}

.result-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.dot { color: var(--line); }

/* ---------- 解读 ---------- */
.reading {
  border-top: 2rpx solid var(--line-soft);
  padding-top: 28rpx;
}

.reading-gua {
  display: block;
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.85;
  margin-bottom: 12rpx;
}

.reading-xiang {
  display: block;
  font-size: 25rpx;
  color: var(--ink-3);
  line-height: 1.9;
  margin-bottom: 24rpx;
}

.reading-box {
  background: var(--paper);
  border-left: 6rpx solid var(--cinnabar);
  border-radius: 0 10rpx 10rpx 0;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}

.reading-box.sub {
  border-left-color: var(--gold);
}

.reading-tag {
  display: block;
  font-size: 21rpx;
  color: var(--ink-4);
  letter-spacing: .18em;
  margin-bottom: 8rpx;
}

.reading-body {
  display: block;
  font-size: 27rpx;
  color: var(--ink-2);
  line-height: 1.85;
}

.reading-changed {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

/* ---------- 音乐参数 ---------- */
.music-params {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
}

.mparam {
  width: calc(33.33% - 8rpx);
  background: var(--paper);
  border-radius: 8rpx;
  padding: 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.mparam-label {
  font-size: 20rpx;
  color: var(--ink-4);
  letter-spacing: .1em;
}

.mparam-value {
  font-size: 25rpx;
  color: var(--ink);
  font-weight: 600;
}

.mparam-sub {
  font-size: 19rpx;
  color: var(--ink-4);
  font-weight: 400;
}

.detail-btn {
  margin-top: 28rpx;
}

/* ---------- 播放器 ---------- */
.player-time {
  font-size: 23rpx;
  color: var(--ink-4);
  letter-spacing: .06em;
}

.progress-wrap {
  margin-bottom: 28rpx;
}

.progress-track {
  position: relative;
  height: 8rpx;
  background: var(--paper-deep);
  border-radius: 4rpx;
}

.progress-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: var(--cinnabar);
  border-radius: 4rpx;
  transition: width .1s linear;
}

.progress-sections {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.prog-sec {
  position: absolute;
  top: 16rpx;
  font-size: 19rpx;
  color: var(--ink-4);
  letter-spacing: .1em;
}

.player-controls {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.btn-play {
  flex: 1;
  background: var(--cinnabar);
  color: #FFF8F0;
  gap: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(178, 58, 46, .22);
}

.play-icon {
  font-size: 24rpx;
}

.player-tip {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--ink-4);
  line-height: 1.7;
}

/* ---------- 拍照识象入口 ---------- */
.camera-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: var(--cinnabar-soft);
  border: 1rpx solid var(--cinnabar);
  border-radius: 12rpx;
}
.camera-entry-icon {
  font-size: 44rpx;
  color: var(--cinnabar);
  line-height: 1;
}
.camera-entry-body {
  flex: 1;
  min-width: 0;
}
.camera-entry-title {
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.camera-entry-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.camera-entry-arrow {
  font-size: 40rpx;
  color: var(--cinnabar);
}

/* 循环播放按钮：开启时以朱色标示 */
.btn-loop {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.btn-loop .loop-icon {
  font-size: 26rpx;
}

.btn-loop.on {
  color: var(--cinnabar);
  border-color: var(--cinnabar);
  background: var(--cinnabar-soft);
}
