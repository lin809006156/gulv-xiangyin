/* 音乐页 */
.mp-page { padding-top: 20rpx; }

/* ---------- 当前心音 ---------- */
.mn-head { display: flex; align-items: center; gap: 22rpx; }
.mn-symbol {
  width: 96rpx; height: 96rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; color: var(--cinnabar);
  background: var(--cinnabar-soft);
  border-radius: 26rpx;
}
.mn-title { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.mn-name { font-size: 36rpx; font-weight: 700; letter-spacing: .06em; }
.mn-meta { font-size: 23rpx; color: var(--ink-3); letter-spacing: .04em; }
.mn-params {
  display: flex; flex-wrap: wrap; gap: 12rpx;
  margin-top: 22rpx;
}
.mn-params .mp {
  flex: 1 1 28%;
  min-width: 150rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,.55);
  border: 1rpx solid rgba(178,160,132,.16);
  display: flex; flex-direction: column; gap: 2rpx;
}
.mp-label { font-size: 20rpx; color: var(--ink-4); letter-spacing: .08em; }
.mp-value { font-size: 25rpx; color: var(--ink); font-weight: 600; }
.mp-sub { font-size: 19rpx; color: var(--ink-4); }

.me-icon { font-size: 56rpx; color: var(--ink-3); text-align: center; display: block; }
.me-title { display: block; text-align: center; font-size: 30rpx; font-weight: 700; margin-top: 10rpx; }
.me-desc { display: block; text-align: center; font-size: 24rpx; color: var(--ink-3); margin: 10rpx 0 24rpx; }

/* ---------- 波形台 ---------- */
.viz-wrap {
  border-radius: 22rpx;
  overflow: hidden;
  background: #0E161F;
  box-shadow: 0 0 0 1rpx rgba(178,160,132,.18), 0 16rpx 40rpx rgba(10,18,28,.24);
}
.viz { display: block; width: 100%; height: 300rpx; }

/* ---------- 播放控制 ---------- */
.player-controls {
  display: flex; align-items: center; gap: 14rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}
.pc-ico { font-size: 26rpx; }
.vol { flex: 1; min-width: 180rpx; display: flex; align-items: center; gap: 10rpx; }
.vol-ico { font-size: 26rpx; color: var(--ink-3); }
.vol-slider { flex: 1; margin: 0; }
.gen-live { display: flex; align-items: center; gap: 8rpx; }
.live-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--cinnabar);
  animation: livePulse 1.4s ease-in-out infinite;
}
.live-txt { font-size: 22rpx; color: var(--ink-3); letter-spacing: .06em; }
@keyframes livePulse {
  0%, 100% { opacity: .35; transform: scale(.8); }
  50% { opacity: 1; transform: scale(1.15); }
}

/* ---------- 乐器园 ---------- */
.inst-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.inst {
  flex: 1 1 44%;
  min-width: 300rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,.5);
  border: 1rpx solid rgba(178,160,132,.16);
  display: flex; flex-direction: column; gap: 6rpx;
}
.inst-top { display: flex; align-items: baseline; gap: 10rpx; }
.inst-name { font-size: 28rpx; font-weight: 700; }
.inst-tag { font-size: 20rpx; color: var(--cinnabar); background: var(--cinnabar-soft); padding: 2rpx 10rpx; border-radius: 8rpx; }
.inst-desc { font-size: 22rpx; color: var(--ink-3); line-height: 1.6; }
.inst-cite { font-size: 19rpx; color: var(--ink-4); }
.inst-btn { align-self: flex-start; margin-top: 6rpx; }
.inst-btn.is-on { color: var(--cinnabar); border-color: rgba(178,58,46,.4); }
