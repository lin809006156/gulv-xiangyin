<!-- 识象页：拍照识别物象并起卦 -->
<view class="page">

  <!-- ============ 顶部说明 ============ -->
  <view class="head">
    <view class="head-title">拍照识象</view>
    <view class="head-sub">拍下眼前的物，取卦成音</view>
    <view class="head-note">
      只取<text class="em">物本身</text>——空椅子就是椅子，桌子上有没有东西不影响取卦。
    </view>
  </view>

  <!-- ============ 照片区 ============ -->
  <view class="card photos-card">
    <view class="photos">
      <view class="photo-item" wx:for="{{photos}}" wx:key="path">
        <image class="photo-img" src="{{item.path}}" mode="aspectFill"
               data-idx="{{index}}" bindtap="previewPhoto" />
        <view class="photo-del" data-idx="{{index}}" catchtap="removePhoto">×</view>
      </view>

      <view wx:if="{{photos.length < 3}}" class="photo-add" bindtap="takePhoto">
        <view class="photo-add-icon">＋</view>
        <view class="photo-add-text">拍照</view>
      </view>
    </view>

    <view class="photo-actions">
      <button class="btn btn-primary" bindtap="recognize"
              disabled="{{!photos.length || stage === 'recognizing'}}">
        {{stage === 'recognizing' ? '正在识象…' : '识象起卦'}}
      </button>
      <button class="btn btn-ghost" bindtap="fromAlbum" disabled="{{photos.length >= 3}}">
        相册
      </button>
    </view>

    <view class="tip-line">可拍多张作参考，起卦以第一张为准</view>
  </view>

  <!-- ============ 提示 ============ -->
  <view wx:if="{{hint}}" class="notice {{allFallback ? 'notice-warn' : ''}} {{empty ? 'notice-warn' : ''}}">
    <text class="notice-text">{{hint}}</text>
  </view>

  <!-- ============ 识别候选 ============ -->
  <view wx:if="{{candidates.length}}" class="card">
    <view class="card-title">
      <text>识别到的物象</text>
      <text class="card-title-sub">点任一项即可改卦</text>
    </view>

    <view class="cands">
      <view class="cand {{selectedIndex === index ? 'cand-on' : ''}}"
            wx:for="{{candidates}}" wx:key="gua"
            data-idx="{{index}}" bindtap="selectCandidate">
        <view class="cand-symbol">{{item.symbol}}</view>
        <view class="cand-main">
          <view class="cand-name">
            {{item.label}}
            <text class="cand-tag" wx:if="{{!item.matched}}">未收录</text>
          </view>
          <view class="cand-gua">{{item.guaName}}卦 · {{item.nature}}</view>
          <view class="cand-reason">{{item.reason}}</view>
        </view>
        <view class="cand-conf" wx:if="{{item.matched}}">{{item.confidence}}</view>
      </view>
    </view>

    <button class="btn btn-primary btn-block" bindtap="castSelected">以此物象起卦</button>
  </view>

  <!-- ============ 卦象结果 ============ -->
  <view wx:if="{{result}}" class="card result-card">
    <view class="result-image">所见之象 · {{result.imageName}}</view>
    <view class="result-symbol">{{result.hexSymbol}}</view>
    <view class="result-name">{{result.hexName}}</view>
    <view class="result-xiang">{{result.xiang}}</view>
    <view class="result-hint">{{result.hint}}</view>

    <view class="result-meta">
      <view class="meta-item">
        <view class="meta-k">所属</view>
        <view class="meta-v">{{result.guaName}}{{result.guaSymbol}}</view>
      </view>
      <view class="meta-item">
        <view class="meta-k">动爻</view>
        <view class="meta-v">第 {{result.movingLine}} 爻</view>
      </view>
      <view class="meta-item">
        <view class="meta-k">调式</view>
        <view class="meta-v">{{result.music.modeName}}</view>
      </view>
      <view class="meta-item">
        <view class="meta-k">音色</view>
        <view class="meta-v">{{result.music.voiceText}}</view>
      </view>
    </view>

    <button class="btn btn-primary btn-block" bindtap="goDetail">听这一卦的心音</button>
  </view>

  <!-- ============ 手动选物象（常驻兜底，永不关闭） ============ -->
  <view class="card">
    <view class="card-title">
      <text>{{manualMode ? '手动选物象' : '也可以直接选'}}</text>
      <text class="card-title-sub">共 {{library.length}} 类</text>
    </view>

    <view class="search-bar">
      <input class="search-input" placeholder="搜名字，如：桌子 / 椅子 / 狗"
             value="{{searchKw}}" bindinput="onSearchInput" />
      <view class="search-clear" wx:if="{{searchKw}}" bindtap="clearSearch">×</view>
    </view>

    <!-- 搜索结果 -->
    <view wx:if="{{searchResults.length}}" class="search-results">
      <view class="chip" wx:for="{{searchResults}}" wx:key="image"
            data-gua="{{item.gua}}" data-name="{{item.image}}" bindtap="selectSearch">
        {{item.image}} · {{item.guaName}}
      </view>
    </view>

    <!-- 分类切换 -->
    <scroll-view class="cats" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="cat {{activeCategory === item ? 'cat-on' : ''}}"
            wx:for="{{categories}}" wx:key="*this"
            data-cat="{{item}}" bindtap="onCategoryTap">{{item}}</view>
    </scroll-view>

    <!-- 该分类物象 -->
    <view class="items">
      <view class="item" wx:for="{{categoryItems}}" wx:key="name"
            data-gua="{{item.gua}}" data-name="{{item.name}}" bindtap="selectFromLibrary">
        <view class="item-symbol">{{item.symbol}}</view>
        <view class="item-name">{{item.name}}</view>
        <view class="item-gua">{{item.guaName}}</view>
      </view>
    </view>
  </view>

  <view class="footer-note">
    物象取自《说卦传》，卦象音乐仅供文化赏析与情绪调节，不作吉凶断语。
  </view>

</view>