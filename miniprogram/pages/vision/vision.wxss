/* 识象页样式 —— 宣纸墨色，沿用 app.wxss 的设计变量 */

.page {
  padding: 24rpx 24rpx 60rpx;
}

/* ============ 顶部说明 ============ */
.head {
  padding: 12rpx 8rpx 24rpx;
}
.head-title {
  font-size: 44rpx;
  color: var(--ink);
  letter-spacing: 6rpx;
}
.head-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}
.head-note {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--paper-deep);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-2);
}
.head-note .em {
  color: var(--cinnabar);
  font-weight: 500;
}

/* ============ 照片区 ============ */
.photos-card {
  margin-bottom: 20rpx;
}
.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}
.photo-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line-soft);
}
.photo-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: var(--ink);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}
.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--line);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--ink-3);
}
.photo-add-icon {
  font-size: 56rpx;
  line-height: 1;
}
.photo-add-text {
  margin-top: 12rpx;
  font-size: 24rpx;
}
.photo-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}
.photo-actions .btn {
  flex: 1;
}
.tip-line {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ink-4);
  text-align: center;
}

/* ============ 提示条 ============ */
.notice {
  padding: 20rpx 24rpx;
  background: var(--paper-deep);
  border-left: 4rpx solid var(--line);
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.notice-warn {
  border-left-color: var(--cinnabar);
}
.notice-text {
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

/* ============ 候选卡 ============ */
.card-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.card-title-sub {
  font-size: 22rpx;
  color: var(--ink-4);
  letter-spacing: 0;
}

.cands {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.cand {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  border: 1rpx solid var(--line-soft);
  border-radius: 12rpx;
  background: var(--card);
  transition: all .2s ease;
}
.cand-on {
  border-color: var(--cinnabar);
  background: rgba(178, 58, 46, .05);
}
.cand-symbol {
  font-size: 40rpx;
  color: var(--ink);
  line-height: 1.2;
  flex-shrink: 0;
}
.cand-main {
  flex: 1;
  min-width: 0;
}
.cand-name {
  font-size: 28rpx;
  color: var(--ink);
}
.cand-tag {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: var(--cinnabar);
  border: 1rpx solid var(--cinnabar);
  border-radius: 6rpx;
}
.cand-gua {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.cand-reason {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-4);
  line-height: 1.6;
}
.cand-conf {
  font-size: 22rpx;
  color: var(--ink-4);
  font-family: -apple-system, "PingFang SC", sans-serif;
  flex-shrink: 0;
}

/* ============ 结果 ============ */
.result-card {
  border-color: var(--cinnabar);
}
.result-image {
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}
.result-symbol {
  font-size: 72rpx;
  color: var(--ink);
  line-height: 1;
}
.result-name {
  margin-top: 12rpx;
  font-size: 40rpx;
  color: var(--ink);
  letter-spacing: 6rpx;
}
.result-xiang {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.8;
}
.result-hint {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  background: var(--paper-deep);
  border-radius: 10rpx;
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--ink-2);
}
.result-meta {
  margin: 24rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.meta-item {
  flex: 1;
  min-width: 140rpx;
  padding: 16rpx;
  background: var(--paper-deep);
  border-radius: 10rpx;
  text-align: center;
}
.meta-k {
  font-size: 21rpx;
  color: var(--ink-4);
}
.meta-v {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--ink);
}

/* ============ 搜索与物象库 ============ */
.search-bar {
  position: relative;
  margin-bottom: 16rpx;
}
.search-input {
  height: 72rpx;
  padding: 0 60rpx 0 24rpx;
  background: var(--paper-deep);
  border-radius: 10rpx;
  font-size: 26rpx;
  color: var(--ink);
}
.search-clear {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  color: var(--ink-4);
  font-size: 32rpx;
}
.search-results {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.chip {
  padding: 12rpx 22rpx;
  background: var(--paper-deep);
  border: 1rpx solid var(--line-soft);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--ink);
}

.cats {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.cat {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  background: var(--paper-deep);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.cat-on {
  background: var(--ink);
  color: var(--card);
}

.items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.item {
  width: calc(25% - 9rpx);
  padding: 18rpx 8rpx;
  background: var(--paper-deep);
  border-radius: 10rpx;
  text-align: center;
}
.item-symbol {
  font-size: 34rpx;
  color: var(--ink);
}
.item-name {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-gua {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--ink-4);
}

.footer-note {
  margin-top: 40rpx;
  font-size: 21rpx;
  color: var(--ink-4);
  line-height: 1.7;
  text-align: center;
}