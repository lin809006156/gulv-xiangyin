<template name="miniplayer">
  <view class="miniplayer {{nobar ? 'nobar' : ''}}" wx:if="{{m.isPlaying}}">
    <view class="mp-wave">
      <view class="w1"></view><view class="w2"></view><view class="w3"></view><view class="w4"></view>
    </view>
    <view class="mp-info" bindtap="miniGoMusic">
      <text class="mp-title">{{m.title}}</text>
      <text class="mp-sub">{{m.subtitle}}</text>
    </view>
    <!-- 播放 / 暂停：纯 CSS 三角与双竖条（不依赖 Unicode 字形，跨机型一致） -->
    <!-- 图标显隐看「paused」：暂停时引擎仍在播（isPlaying 为 true），
         若拿 isPlaying 判断，暂停后图标永远不会变。 -->
    <view class="mp-btn mp-play" bindtap="miniPlay">
      <view class="ico-play {{m.isPlaying && !m.paused ? 'is-hidden' : ''}}"></view>
      <view class="ico-pause {{m.isPlaying && !m.paused ? '' : 'is-hidden'}}">
        <view class="ico-bar"></view><view class="ico-bar"></view>
      </view>
    </view>
    <!-- 循环：纯 CSS 圆环 + 箭头 -->
    <view class="mp-btn {{m.loopOn ? 'is-on' : ''}}" bindtap="miniLoop">
      <view class="ico-loop"></view>
    </view>
  </view>
</template>
